    {
      "description": null,
      "keys": [
        {
          "default": true,
          "description": "Gate the rate_limit filter's volume penalties (burst/per-minute/approaching) on per-op risk, so a burst of untainted routine file churn (~/.cache, .git/ internals, build outputs) never escalates. The supervisor's target-aware mass-destruction signal backfills the one case this drops (an untainted destructive spree). See work/futurework/rate-limit-burst-redesign.md.  ON by default (rollout step 4). Setting this false restores the legacy frequency-blind burst counter and also forfeits the scratch/~/.cache/.git exemptions (retired in favour of this gate) — expect routine-churn prompts.",
          "name": "risk_gated_burst",
          "type": "boolean"
        }
      ],
